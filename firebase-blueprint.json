{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Authenticated user profile and role metadata for MEDRESQ AI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "maxLength": 64 },
        "phcId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email"]
    },
    "LogisticsOrderDoc": {
      "title": "Logistics Order",
      "description": "Pharmacy and medicine replenishment requisition order document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "phcId": { "type": "string", "maxLength": 64 },
        "phcName": { "type": "string", "maxLength": 128 },
        "medicineName": { "type": "string", "maxLength": 128 },
        "quantityRequested": { "type": "number" },
        "source": { "type": "string", "maxLength": 128 },
        "destination": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 64 },
        "requestDate": { "type": "string", "maxLength": 32 },
        "priority": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 512 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "phcId", "medicineName", "quantityRequested", "status"]
    },
    "ChatMessageDoc": {
      "title": "Chat Message",
      "description": "Multi-turn conversational log between user and Gemini assistant",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 32 },
        "content": { "type": "string", "maxLength": 8192 },
        "modelUsed": { "type": "string", "maxLength": 64 },
        "persona": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "role", "content"]
    },
    "VoiceLogDoc": {
      "title": "Voice Transcription Log",
      "description": "Historical log of speech-to-text transcriptions and parsed inventory actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "transcript": { "type": "string", "maxLength": 4096 },
        "parsedMedicine": { "type": "string", "maxLength": 128 },
        "parsedQuantity": { "type": "number" },
        "parsedTransaction": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "transcript"]
    },
    "TestConnectionDoc": {
      "title": "Test Connection",
      "description": "Diagnostic document used to verify client connection to Firestore",
      "type": "object",
      "properties": {
        "status": { "type": "string", "maxLength": 32 }
      }
    },
    "OfflineSyncAuditDoc": {
      "title": "Offline Sync Audit Record",
      "description": "Audit record of synchronized offline transaction items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 64 },
        "syncedAt": { "type": "string", "maxLength": 64 },
        "syncedBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["id", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profile store for authenticated staff"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "LogisticsOrderDoc" },
      "description": "Requisition order collection for supply chain management"
    },
    "/chat_messages/{messageId}": {
      "schema": { "$ref": "ChatMessageDoc" },
      "description": "Multi-turn Gemini chat message history"
    },
    "/voice_logs/{logId}": {
      "schema": { "$ref": "VoiceLogDoc" },
      "description": "Audio voice transcription audit log"
    },
    "/offline_sync_audit/{auditId}": {
      "schema": { "$ref": "OfflineSyncAuditDoc" },
      "description": "Offline synchronization audit record storage"
    },
    "/test/{testId}": {
      "schema": { "$ref": "TestConnectionDoc" },
      "description": "Connection test document for health checks"
    }
  }
}
