# GEMINI_API_KEY: Required for server-side Gemini AI API calls (@google/genai).
# Inject via Google Cloud Run Secret Manager or AI Studio Secrets. Never expose to client.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_ASSISTANT_MODEL="gemini-3-flash-preview"
GEMINI_FAST_MODEL="gemini-3.1-flash-lite-preview"

# Google Cloud Project & Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI="false"
GOOGLE_CLOUD_PROJECT="ultimate-correlate-zsmzh"
GOOGLE_CLOUD_LOCATION="asia-southeast1"

# Cloud Run Server Port (Automatically injected by Google Cloud Run at runtime)
PORT="3000"

# Open Government Data (OGD) Platform India (https://data.gov.in) API Key (Optional server-side key)
DATA_GOV_IN_API_KEY="YOUR_DATA_GOV_IN_API_KEY"

# APP_URL: The URL where this application is hosted
APP_URL="https://your-cloud-run-service.run.app"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform public client key (Optional)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Cloud SQL Runtime & Migration Environment Variables (Automatically provided at runtime)
SQL_HOST="/cloudsql/instance-connection-name"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"
